@page "/login"
@rendermode InteractiveWebAssembly

<PageTitle>Iniciar Sesión</PageTitle>

<div class="min-h-dvh w-full select-none bg-zinc-50 dark:bg-zinc-950">
    <div class="grid min-h-dvh grid-cols-1 lg:grid-cols-2">

        @* ===== COLUMNA IZQUIERDA: Formulario ===== *@
        <div class="flex w-full items-center justify-center px-12 py-12 lg:px-6">
            <div class="w-full max-w-md">

                @* Header con logo y nombre *@
                @if (Section == 0)
                {
                    <div class="mb-8 flex items-center gap-3">
                        <div class="flex items-center justify-center">
                            <img class="h-10 w-10" src="./favicon.png" />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-lg font-bold tracking-tight text-zinc-900 dark:text-white">
                                LIN
                                <span class="bg-gradient-to-r from-current-500 to-current-600 bg-clip-text text-transparent">
                                    Contacts
                                </span>
                            </span>
                            <span class="text-sm text-zinc-500 dark:text-zinc-400">Tu agenda personal</span>
                        </div>
                    </div>
                }

                @* Secciones *@
                <div>

                    @* Formulario de acceso *@
                    @if (Section == 0)
                    {
                        @* Título *@
                        <div class="mb-8">
                            @if (IsWithKey)
                            {
                                <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Iniciar sesión con Passkey</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Iniciar sesión en tu cuenta</h2>
                            }
                            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
                                No tienes una cuenta?
                                <a style="text-decoration: none !important;"
                                   class="font-medium text-current-500 hover:text-current-800"
                                   href="/register">Regístrate</a> para iniciar a disfrutar
                            </p>
                        </div>

                        @* Campos *@
                        <div class="grid grid-cols-1 gap-4">

                            @* Usuario *@
                            <div>
                                <label class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
                                    Usuario
                                </label>
                                <input @ref="userInput"
                                       @onkeydown="HandleUserKeyDown"
                                       @onkeypress="HideError"
                                       @bind="User"
                                       type="text"
                                       autocomplete="off"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       required=""
                                       class="block w-full appearance-none rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-zinc-900 placeholder-zinc-400 focus:border-current-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-current-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 sm:text-sm dark:focus:bg-zinc-900">
                            </div>

                            @* Contraseña *@
                            @if (!IsWithKey)
                            {
                                <div>
                                    <label class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
                                        Contraseña
                                    </label>
                                    <input @ref="passwordInput"
                                           @onkeydown="HandlePasswordKeyDown"
                                           @onkeypress="HideError"
                                           @bind="Password"
                                           type="password"
                                           autocomplete="off"
                                           data-lpignore="true"
                                           data-1p-ignore="true"
                                           class="block w-full appearance-none rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-zinc-900 placeholder-zinc-400 focus:border-current-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-current-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 sm:text-sm dark:focus:bg-zinc-900">
                                </div>
                            }

                            @* Mensaje de error *@
                            <center class="@(ErrorVisible ? "visible" : "hidden")" style="margin-bottom: -10px;">
                                <label class="text-sm font-bold text-red-500">@ErrorMessage</label>
                            </center>

                            @* Botones de acción *@
                            <div class="mt-2 flex flex-row">

                                @* Iniciar sesión *@
                                <button @onclick="Start"
                                        class="group inline-flex w-full items-center justify-center rounded-full bg-current-600 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-current-500/10 hover:bg-current-800 hover:text-slate-100 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500 active:bg-current-800 active:text-current-100 dark:bg-current-600">
                                    <span>Iniciar <span aria-hidden="true">→</span></span>
                                </button>

                                @* Passkey toggle *@
                                <button @onclick="GotoLoginKey" type="button"
                                        class="ml-2 flex w-20 items-center justify-center rounded-full bg-current-600 p-2.5 text-center text-sm font-medium text-white shadow-lg shadow-current-500/10 hover:bg-current-800 focus:outline-none focus:ring-4 focus:ring-current-300 dark:bg-current-600">
                                    @if (IsWithKey)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm7 11a1 1 0 1 0-2 0 1 1 0 0 0 2 0z" />
                                        </svg>
                                    }
                                </button>

                            </div>

                            @* Olvidé mi contraseña *@
                            <div class="flex flex-row items-end justify-end">
                                <label @onclick="GoToForget"
                                       class="cursor-pointer text-sm font-medium text-current-500 hover:text-current-800">
                                    Olvidé mi contraseña
                                </label>
                            </div>

                        </div>
                    }

                    @* Éxito *@
                    else if (Section == 1)
                    {
                        <div class="flex flex-col items-center justify-center py-10">
                            <LIN.Contacts.Shared.Components.Success />
                        </div>
                    }

                    @* Fallido *@
                    else if (Section == 2)
                    {
                        <div class="flex flex-col items-center justify-center py-10">
                            <LIN.Contacts.Shared.Components.Failure />
                            <label class="mt-2 text-red-500">@ErrorMessage</label>
                        </div>
                    }

                    @* Cargando *@
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-10">
                            <LIN.Contacts.Shared.Components.CircleLoader />
                            <h5 class="mt-3 text-sm font-bold text-zinc-600 dark:text-zinc-300">@LogMessage</h5>
                            @if (ShowButtonCancel)
                            {
                                <label @onclick="CancelPasskey"
                                       class="mt-2 cursor-pointer text-sm text-zinc-500 hover:text-current-500 dark:text-zinc-400">
                                    Cancelar
                                </label>
                            }
                        </div>
                    }

                </div>

            </div>
        </div>

        @* ===== COLUMNA DERECHA: Imagen ===== *@
        <div class="hidden rounded-lg p-6 lg:block">
            <div class="bg-image h-full w-full rounded-3xl"></div>
        </div>

    </div>
</div>
